{
  "name": "google-ads-reference-collector",
  "version": "0.1.0",
  "private": true,
  "description": "경쟁사 구글 광고 레퍼런스 자동 수집·조회 시스템 (로컬 우선 → Azure 배포)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "migrate": "pnpm --filter @adref/core migrate",
    "seed": "tsx scripts/seed.ts",
    "trigger": "tsx scripts/trigger.ts",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "dev:functions": "pnpm --filter @adref/functions start",
    "dev:dashboard": "pnpm --filter @adref/dashboard dev"
  },
  "dependencies": {
    "@adref/core": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
