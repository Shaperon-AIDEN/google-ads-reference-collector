<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  매일 예약 시각 10분 전에 "로그아웃 전용 프로필" Chrome 을 자동 기동한다.
  (chrome.alarms 는 Chrome 이 켜져 있어야 발화하므로)
  설치:
    cp tools/chrome-extension/launchd/com.adref.autocollect.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.adref.autocollect.plist
  해제:
    launchctl unload ~/Library/LaunchAgents/com.adref.autocollect.plist
  StartCalendarInterval 시각은 확장 팝업의 자동 수집 시각(기본 12:30)보다 앞서게 유지.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.adref.autocollect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-na</string>
    <string>Google Chrome</string>
    <string>--args</string>
    <string>--user-data-dir=/Users/Sungmin/.adref-chrome-profile</string>
    <string>--no-first-run</string>
    <string>https://adstransparency.google.com/?region=KR</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>20</integer>
  </dict>
</dict>
</plist>
