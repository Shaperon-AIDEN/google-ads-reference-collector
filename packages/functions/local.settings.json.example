{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AzureWebJobsFeatureFlags": "EnableWorkerIndexing",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "DATABASE_URL": "postgres://adref:adref@localhost:5432/adref",
    "ADS_SOURCE": "serpapi",
    "SERPAPI_KEY": "<local dev key>",
    "YOUTUBE_API_KEY": "<local dev key>",
    "AD_QUEUE_NAME": "new-ads",
    "BLOB_CONTAINER": "thumbnails",
    "QUOTA_MONTHLY_BUDGET": "5000",
    "QUOTA_THROTTLE_PCT": "0.8",
    "AUTH_MODE": "mock",
    "AD_LIST_CRON": "0 0 0,12 * * *",
    "VIEW_COUNT_CRON": "0 0 3 * * *"
  }
}
