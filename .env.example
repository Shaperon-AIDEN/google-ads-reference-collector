# ── 로컬 개발 공용 환경 변수 (dashboard, scripts, tests) ──
# 실제 값은 .env 로 복사해 채운다. .env 는 커밋 금지(.gitignore 처리됨).

# Postgres (docker-compose)
POSTGRES_USER=adref
POSTGRES_PASSWORD=adref
DATABASE_URL=postgres://adref:adref@localhost:5432/adref

# Azure Storage — 로컬은 Azurite 개발 스토리지
AzureWebJobsStorage=UseDevelopmentStorage=true

# 외부 데이터 소스
ADS_SOURCE=serpapi
SERPAPI_KEY=
YOUTUBE_API_KEY=

# 큐 / Blob
AD_QUEUE_NAME=new-ads
BLOB_CONTAINER=thumbnails

# 쿼터 가드
QUOTA_MONTHLY_BUDGET=5000
QUOTA_THROTTLE_PCT=0.8

# 인증 (로컬은 mock, Azure는 entra)
AUTH_MODE=mock

# 스케줄 (CRON) — 재배포 없이 앱 설정으로 변경
AD_LIST_CRON=0 0 0,12 * * *
VIEW_COUNT_CRON=0 0 3 * * *
