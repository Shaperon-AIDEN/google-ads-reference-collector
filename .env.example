# ═══════════════════════════════════════════════════════════════════════
# 로컬 개발 공용 환경 변수 (dashboard, scripts, tests 공용)
#
# 사용법:  cp .env.example .env  후 실제 값을 채운다.
#          .env 는 커밋 금지(.gitignore 처리됨). 시크릿은 절대 코드/문서에 하드코딩하지 않는다.
#
# 수집기(Functions)는 이 파일이 아니라 packages/functions/local.settings.json 을 읽는다
# (같은 키 이름 사용 — local.settings.json.example 참조). Azure 배포 시엔 두 파일 모두
# 대신 앱 설정/Key Vault 로 같은 키를 주입한다 → 코드 변경 없이 설정만으로 로컬↔Azure 전환.
# 전체 키의 검증 스키마: packages/core/src/config/env.ts (zod)
# ═══════════════════════════════════════════════════════════════════════


# ── 데이터베이스 (필수) ──────────────────────────────────────────────────
# docker-compose 가 띄우는 로컬 PostgreSQL 16 기준값. `pnpm compose:up` 후 `pnpm migrate`.
# Azure 전환 시엔 Flexible Server 접속 문자열로 교체 (끝에 ?sslmode=require 필요).
POSTGRES_USER=adref
POSTGRES_PASSWORD=adref
DATABASE_URL=postgres://adref:adref@localhost:5432/adref

# ── Azure Storage (큐·Blob) ─────────────────────────────────────────────
# 수집 파이프라인의 큐(new-ads, collect-requests)와 썸네일 Blob 이 사용.
# 로컬은 Azurite 에뮬레이터(docker-compose 포함) → 아래 값 그대로 두면 됨.
# Azure 는 Storage 계정 연결 문자열. 대시보드도 이 값으로 "수집 진행상황"(큐 잔량)을 조회한다.
AzureWebJobsStorage=UseDevelopmentStorage=true

# ── 광고 데이터 소스 (서버 측) ───────────────────────────────────────────
# 어떤 방식으로 투명성 센터 데이터를 가져올지 선택. 값만 바꾸면 즉시 전환(코드 무변경).
#   serpapi : SerpApi 상용 API. 안정적·유료(쿼터 소모). 도메인 검색 지원.
#   crawl   : 투명성 센터 내부 RPC 직접 호출. 무료·비공식 — 형식 변경/봇 차단 리스크.
#             ⚠️ 데이터센터 IP(Azure 등)는 대량 크롤 시 차단되기 쉬움(실측).
#             대량 초기 수집은 Chrome 확장(tools/chrome-extension) 경로를 권장.
# 문제가 생기면 serpapi 로 되돌리는 것이 안전한 롤백 경로.
ADS_SOURCE=serpapi

# SerpApi API 키 — https://serpapi.com (Free 250회/월, 운영은 Developer 5,000회/월 권장)
# ADS_SOURCE=crawl 만 쓰고 도메인 검색도 안 쓰면 비워둬도 된다.
SERPAPI_KEY=

# YouTube Data API v3 키 — Google Cloud Console 에서 발급 (무료 쿼터 10,000유닛/일).
# 비디오 광고의 조회수·좋아요·게시일 수집에 사용. videos.list 1회=1유닛이라 사실상 무제한.
YOUTUBE_API_KEY=

# ── 수집·표시 스코프 ────────────────────────────────────────────────────
#   video : 비디오 광고만 수집·표시 (원래 기본)
#   all   : 텍스트·이미지 광고 포함 (현재 운영값)
# 수집기·대시보드가 같은 값을 읽는다. 되돌리려면 이 값만 video 로.
# 참고: 조회수·좋아요는 비디오(YouTube)에만 존재 — 텍스트/이미지는 구조상 없음.
COLLECT_FORMATS=video

# ── 큐 / Blob 이름 ──────────────────────────────────────────────────────
# 바꿀 일 거의 없음. 로컬(Azurite)·Azure 에서 같은 이름 사용.
AD_QUEUE_NAME=new-ads              # 상세 수집 대기열 (광고 1건 = 메시지 1건)
COLLECT_QUEUE_NAME=collect-requests # "지금 수집" 요청 + 목록 이어달리기(continuation)
BLOB_CONTAINER=thumbnails           # 비디오 썸네일 캐시

# ── SerpApi 쿼터 가드 ───────────────────────────────────────────────────
# 월 호출 예산과 스로틀 임계 비율. 사용량이 예산×임계 비율(기본 80%)에 닿으면
# 수집을 partial 로 멈춰 쿼터 소진을 방지한다. crawl 소스는 apiCalls=0 이라 무관.
QUOTA_MONTHLY_BUDGET=5000
QUOTA_THROTTLE_PCT=0.8

# ── 대시보드 인증 ───────────────────────────────────────────────────────
#   mock  : 로컬/현재 운영 — 자체 회원가입·세션 사용 (가입 허용 도메인:
#           nizcorp.com·shaperon.com — packages/dashboard/lib/accounts.ts)
#   entra : App Service Easy Auth(Entra ID) 헤더를 신뢰 (도입 시)
AUTH_MODE=mock

# ── 대시보드 → 수집기 프록시 주소 ────────────────────────────────────────
# "지금 수집" 버튼이 호출하는 Functions HTTP 베이스. 로컬 기본값이면 생략 가능.
# Azure 대시보드에는 https://<function-app>.azurewebsites.net/api 를 설정.
FUNCTIONS_BASE_URL=http://localhost:7071/api

# ── 스케줄 (NCRONTAB 6필드: 초 분 시 일 월 요일, UTC 기준) ────────────────
# 재배포 없이 값만 바꾸면 다음 발화부터 적용.
AD_LIST_CRON=0 0 0,12 * * *   # 신규 광고 감지·수집 — UTC 00/12시 = KST 09/21시 (하루 2회)
VIEW_COUNT_CRON=0 0 3 * * *   # 전체 조회수·좋아요 스냅샷 — UTC 03시 = KST 12시 (매일)

# ── 크롤 봇 차단 완화 (ADS_SOURCE=crawl 전용) ────────────────────────────
# 요청 간 간격(ms). 실제 간격은 지터로 이 값~2배. 전송 계층이 전역 직렬화되어
# 병렬 실행이어도 모든 요청이 이 간격을 지킨다.
# 실측: 순차 1200ms 로 대형 광고주 전량 목록 수집 통과 → 1500 을 운영값으로 사용.
CRAWL_THROTTLE_MS=1500

# 상세 수집을 N건 단위로 끊고(기본 500) 그 사이 휴식(ms, 기본 10분).
# 실측: 502건 연속 상세 수집 시 봇 차단 → "500건 수집 → 10분 휴식 → 자동 재개" 로 분할.
# 상태는 DB(crawl_pacing)에 저장되어 재시작에도 유지. 0 이면 페이싱 끔. serpapi 소스엔 미적용.
CRAWL_RUN_LIMIT=500
CRAWL_RUN_PAUSE_MS=600000
